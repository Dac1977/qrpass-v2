generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  vecino
  guardia
  admin
  super_admin
}

enum EstadoAprobacion {
  pendiente
  aprobado
  rechazado
}

model User {
  id                String           @id @default(uuid())
  email             String           @unique
  password          String
  nombre            String?
  telefono          String?
  numeroCasa        String?          @map("numero_casa")
  rol               Rol              @default(vecino)
  barrioId          String?          @map("barrio_id")
  activo            Boolean          @default(true)
  estadoAprobacion  EstadoAprobacion @default(pendiente) @map("estado_aprobacion")
  expoPushToken     String?          @map("expo_push_token")
  qrCode            String?          @map("qr_code")
  esTitular         Boolean          @default(true) @map("es_titular")
  titularId         String?          @map("titular_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  reservas          Reserva[]

  @@map("users")
}

enum Plan {
  free
  basic
  pro
}

enum SpaceType {
  residential
  gym
  club
  coworking
  event
  other
}

model Organization {
  id          String   @id @default(uuid())
  nombre      String
  slug        String   @unique
  descripcion String?
  plan        Plan     @default(free)
  activo      Boolean  @default(true)
  ownerId     String   @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  spaces      Space[]

  @@map("organizations")
}

model Space {
  id                 String       @id @default(uuid())
  nombre             String
  direccion          String?
  spaceType          SpaceType    @default(residential) @map("space_type")
  precioPorCasa      Float?       @map("precio_por_casa")
  activo             Boolean      @default(true)
  codigoInvitacion   String?      @unique @map("codigo_invitacion")
  organizationId     String       @map("organization_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  organization       Organization @relation(fields: [organizationId], references: [id])
  memberships        Membership[]

  @@map("spaces")
}

model Membership {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  spaceId          String           @map("space_id")
  rol              Rol              @default(vecino)
  numeroUnidad     String?          @map("numero_unidad")
  estadoAprobacion EstadoAprobacion @default(pendiente) @map("estado_aprobacion")
  activo           Boolean          @default(false)
  fechaSolicitud   DateTime         @default(now()) @map("fecha_solicitud")
  fechaAprobacion  DateTime?        @map("fecha_aprobacion")
  aprobadoPor      String?          @map("aprobado_por")
  createdAt        DateTime         @default(now()) @map("created_at")

  space            Space            @relation(fields: [spaceId], references: [id])

  @@unique([userId, spaceId])
  @@map("memberships")
}

enum TipoIngreso {
  entrada
  salida
}

enum MetodoIngreso {
  qr
  manual
  facial
}

model Ingreso {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  spaceId         String        @map("space_id")
  tipo            TipoIngreso   @default(entrada)
  metodo          MetodoIngreso @default(qr)
  autorizado      Boolean
  motivoRechazo   String?       @map("motivo_rechazo")
  registradoPor   String?       @map("registrado_por")
  invitacionId    String?       @map("invitacion_id")
  personalId      String?       @map("personal_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@map("ingresos")
}

model AlertaEmergencia {
  id           String    @id @default(uuid())
  spaceId      String    @map("space_id")
  vecinoId     String    @map("vecino_id")
  tipo         String
  mensaje      String?
  numeroCasa   String?   @map("numero_casa")
  latitud      Float?
  longitud     Float?
  atendida     Boolean   @default(false)
  atendidaPor  String?   @map("atendida_por")
  atendidaAt   DateTime? @map("atendida_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("alertas_emergencia")
}

model Aviso {
  id        String   @id @default(uuid())
  spaceId   String   @map("space_id")
  autorId   String   @map("autor_id")
  titulo    String
  contenido String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("avisos")
}

enum EstadoExpensa {
  pendiente
  pagada
  vencida
}

model Expensa {
  id           String        @id @default(uuid())
  spaceId      String        @map("space_id")
  userId       String        @map("user_id")
  mes          Int
  anio         Int
  monto        Float
  estado       EstadoExpensa @default(pendiente)
  fechaVenc    DateTime?     @map("fecha_venc")
  fechaPago    DateTime?     @map("fecha_pago")
  comprobante  String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([userId, spaceId, mes, anio])
  @@map("expensas")
}

enum EstadoReserva {
  pendiente
  confirmada
  rechazada
  cancelada
}

enum EstadoPagoReserva {
  sin_costo
  pendiente_mp
  pendiente_transferencia
  pagado
  rechazado
}

model Amenity {
  id                  String   @id @default(uuid())
  spaceId             String   @map("space_id")
  nombre              String
  descripcion         String?
  capacidad           Int?
  horaApertura        String   @map("hora_apertura")
  horaCierre          String   @map("hora_cierre")
  requiereAprobacion  Boolean  @default(false) @map("requiere_aprobacion")
  precioReserva       Float    @default(0) @map("precio_reserva")
  turnosConfig        Json?    @map("turnos_config")
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  reservas            Reserva[]

  @@map("amenities")
}

model Reserva {
  id           String            @id @default(uuid())
  spaceId      String            @map("space_id")
  amenityId    String            @map("amenity_id")
  vecinoId     String            @map("vecino_id")
  fecha        DateTime
  horaInicio   String            @map("hora_inicio")
  horaFin      String            @map("hora_fin")
  estado       EstadoReserva     @default(pendiente)
  monto        Float?            @default(0)
  estadoPago   EstadoPagoReserva @default(sin_costo) @map("estado_pago")
  metodoPago   String?           @map("metodo_pago")
  comprobante  String?           @map("comprobante_url")
  notas        String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  amenity      Amenity           @relation(fields: [amenityId], references: [id])
  vecino       User              @relation(fields: [vecinoId], references: [id])

  @@index([spaceId])
  @@map("reservas")
}

enum EstadoSolicitudEvento {
  pendiente
  aceptada
  rechazada
}

model Event {
  id          String   @id @default(uuid())
  spaceId     String   @map("space_id")
  nombre      String
  descripcion String?
  fechaEvento DateTime @map("fecha_evento")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  links       EventLink[]

  @@map("events")
}

model EventLink {
  id                   String   @id @default(uuid())
  eventId              String   @map("event_id")
  token                String   @unique
  permiteAcompanantes  Boolean  @default(false) @map("permite_acompanantes")
  maxAcompanantes      Int      @default(0) @map("max_acompanantes")
  requiereDni          Boolean  @default(false) @map("requiere_dni")
  usosPorPersona       Int      @default(1) @map("usos_por_persona")
  habilitado           Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")

  event                Event    @relation(fields: [eventId], references: [id])
  solicitudes          EventSolicitud[]

  @@map("event_links")
}

model EventSolicitud {
  id             String               @id @default(uuid())
  eventLinkId    String               @map("event_link_id")
  token          String               @unique
  nombre         String
  dni            String?
  telefono       String?
  acompanantes    Int                  @default(0)
  estado         EstadoSolicitudEvento @default(pendiente)
  qrCode         String               @map("qr_code")
  usosPermitidos Int                  @default(1) @map("usos_permitidos")
  usosActuales   Int                  @default(0) @map("usos_actuales")
  acceptedAt     DateTime?            @map("accepted_at")
  rejectedAt     DateTime?            @map("rejected_at")
  createdAt      DateTime             @default(now()) @map("created_at")

  eventLink      EventLink            @relation(fields: [eventLinkId], references: [id])

  @@map("event_solicitudes")
}

// ─── Reclamos ────────────────────────────────────────────

enum CategoriaReclamo {
  mantenimiento
  seguridad
  limpieza
  ruidos
  espacios_comunes
  general
  otro
}

enum EstadoReclamo {
  pendiente
  en_proceso
  resuelto
}

model Reclamo {
  id          String           @id @default(uuid())
  spaceId     String           @map("space_id")
  userId      String           @map("user_id")
  titulo      String
  descripcion String
  categoria   CategoriaReclamo @default(general)
  estado      EstadoReclamo    @default(pendiente)
  foto        String?
  respuesta   String?
  adminId     String?          @map("admin_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("reclamos")
}

// ─── Personal Permanente ─────────────────────────────────

model PersonalPermanente {
  id        String           @id @default(uuid())
  spaceId   String           @map("space_id")
  vecinoId  String           @map("vecino_id")
  nombre    String
  dni       String?
  foto      String?
  tipo      String           @default("empleada")
  qrCode    String           @unique @map("qr_code")
  activo    Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  permisos  PermisoHorario[]

  @@map("personal_permanente")
}

model PermisoHorario {
  id          String             @id @default(uuid())
  personalId  String             @map("personal_id")
  vecinoId    String             @map("vecino_id")
  diaSemana   Int                @map("dia_semana")
  horaEntrada String?            @map("hora_entrada")
  horaSalida  String?            @map("hora_salida")
  activo      Boolean            @default(true)
  createdAt   DateTime           @default(now()) @map("created_at")

  personal    PersonalPermanente @relation(fields: [personalId], references: [id])

  @@map("permisos_horarios")
}

// ─── Invitaciones ────────────────────────────────────────

enum TipoInvitacion {
  visita
  delivery
}

model Invitacion {
  id           String         @id @default(uuid())
  spaceId      String         @map("space_id")
  vecinoId     String         @map("vecino_id")
  nombre       String
  dni          String?
  telefono     String?
  patente      String?
  tipo         TipoInvitacion @default(visita)
  qrCode       String         @unique @map("qr_code")
  usosMaximos  Int            @default(1) @map("usos_maximos")
  usosActuales Int            @default(0) @map("usos_actuales")
  fechaVence   DateTime?      @map("fecha_vence")
  activo       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("invitaciones")
}

// ─── Contactos ───────────────────────────────────────────

model Contacto {
  id        String   @id @default(uuid())
  vecinoId  String   @map("vecino_id")
  nombre    String
  dni       String?
  telefono  String?
  patente   String?
  foto      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contactos")
}

// ─── Encuestas ───────────────────────────────────────────

model Encuesta {
  id          String    @id @default(uuid())
  spaceId     String    @map("space_id")
  autorId     String    @map("autor_id")
  titulo      String
  descripcion String?
  opciones    Json
  multiple    Boolean   @default(false)
  activa      Boolean   @default(true)
  fechaCierre DateTime? @map("fecha_cierre")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  votos       Voto[]

  @@map("encuestas")
}

model Voto {
  id         String   @id @default(uuid())
  encuestaId String   @map("encuesta_id")
  vecinoId   String   @map("vecino_id")
  opciones   Json
  createdAt  DateTime @default(now()) @map("created_at")

  encuesta   Encuesta @relation(fields: [encuestaId], references: [id])

  @@unique([encuestaId, vecinoId])
  @@map("votos")
}
